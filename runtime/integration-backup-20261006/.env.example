APP_HOST=127.0.0.1
APP_PORT=8787
DATA_DIR=runtime

# Use deepseek for real script generation. Use offline only for local smoke tests.
DEFAULT_PROVIDER=deepseek
ALLOW_PROVIDER_FALLBACK=false
ALLOW_SYNTHETIC_AUDIO_FALLBACK=false

# Optional MoneyPrinterTurbo bridge.
MPT_ROOT=..\MoneyPrinterTurbo
MPT_PYTHON=
MPT_TIMEOUT_SECONDS=180

# DeepSeek uses the OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional OpenAI-compatible TTS endpoint.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Asset providers: offline, upload, or pexels.
ASSET_PROVIDER=offline
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com/v1
MUSIC_DIR=runtime/music

# --- P3 逐镜配音运行时（可选；不装也能跑，默认走系统语音）---
# 需要 edge-tts / whisperx 时先装 Python 3.11 再跑 scripts/setup-audio-runtime.ps1
AUDIO_PYTHON=.venv-audio\Scripts\python.exe
AUDIO_DEVICE=cuda
AUDIO_COMPUTE_TYPE=float16
WHISPER_MODEL=small
AUDIO_MODEL_CACHE=runtime\models
AUDIO_ALLOW_CPU_FALLBACK=true
AUDIO_TIMEOUT_SECONDS=900

# 配音 provider：auto（默认，有云 TTS 走云，否则系统语音）/ windows / openai / edge
TTS_PROVIDER=auto
TTS_FALLBACK_PROVIDERS=edge-tts,windows-system-speech,offline-synthetic-tone

# --- 授权音乐目录（P3）---
MUSIC_CATALOG_PATH=runtime\music\catalog.json
CLOUD_MUSIC_ENABLED=false

# --- 素材来源降级链（P1/P2）---
ASSET_FALLBACK_PROVIDERS=local-library,offline
