# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
# 隔离的音频运行时（edge-tts / whisperx），由 scripts/setup-audio-runtime.ps1
# 或手动 venv 创建，体积很大，不进仓库
.venv-audio/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 密钥与本地配置：绝对不要提交 ---
.env
*.key
*.pem

# --- 编辑器与操作系统 ---
.idea/
.vscode/
.claude/
Thumbs.db
desktop.ini

# --- 前端 ---
node_modules/
dist/

# --- 运行产物：数据库、媒体、日志 ---
runtime/db/*.sqlite3
!runtime/db/.gitkeep
runtime/media/*
!runtime/media/.gitkeep
runtime/logs/*
!runtime/logs/.gitkeep

# --- 媒体与生成物 ---
*.mp4
*.wav
*.mp3
*.srt
*.ppm
*.tmp
*.log

# 假素材包是生成物，用 team/假素材包/make_fixtures.py 重新生成
team/假素材包/fixtures/

# --- smoke 运行产物（scripts/smoke-test.ps1 写到 runtime-smoke/）---
runtime-smoke*/
