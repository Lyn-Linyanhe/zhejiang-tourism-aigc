APP_HOST=127.0.0.1
APP_PORT=8787
DATA_DIR=runtime

# Use deepseek for real script generation. Use offline only for local smoke tests.
DEFAULT_PROVIDER=deepseek
ALLOW_PROVIDER_FALLBACK=false
ALLOW_SYNTHETIC_AUDIO_FALLBACK=false

# Optional MoneyPrinterTurbo bridge.
MPT_ROOT=..\MoneyPrinterTurbo
MPT_PYTHON=
MPT_TIMEOUT_SECONDS=180

# DeepSeek uses the OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional OpenAI-compatible TTS endpoint. Empty means not configured.
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Optional cloud image / video. Empty means the registry skips them.
IMAGE_PROVIDER=auto
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

VIDEO_PROVIDER=auto
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=

# Optional cloud music. Empty keeps the local mood library.
MUSIC_PROVIDER=library
MUSIC_BASE_URL=
MUSIC_API_KEY=
MUSIC_MODEL=

# Default walks cloud-i2v → cloud-t2i → local-library → offline.
# Missing modules or keys are skipped; offline is always last.
# Set offline only when you want the technical scene cards and nothing else.
ASSET_PROVIDER=cloud-i2v
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com/v1
MUSIC_DIR=runtime/music
