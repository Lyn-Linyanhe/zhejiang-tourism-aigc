APP_HOST=127.0.0.1
APP_PORT=8787
DATA_DIR=runtime

# Use deepseek for real script generation. Use offline only for local smoke tests.
DEFAULT_PROVIDER=deepseek
ALLOW_PROVIDER_FALLBACK=false
ALLOW_SYNTHETIC_AUDIO_FALLBACK=false

# Optional MoneyPrinterTurbo bridge.
MPT_ROOT=..\MoneyPrinterTurbo
MPT_PYTHON=
MPT_TIMEOUT_SECONDS=180

# DeepSeek uses the OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional OpenAI-compatible TTS endpoint.
# Set true to use the Windows speech bridge on the same localhost server.
LOCAL_TTS_ENABLED=false
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Asset providers: offline, upload, or pexels.
ASSET_PROVIDER=offline
PIXABAY_API_KEY=
# Example: {"guide-zh":"中文导览"} (voice ID to display name)
TTS_VOICE_CATALOG={}
# auto: WhisperX / Whisper; sentence: measured phrase durations only.
SUBTITLE_ALIGNMENT=auto
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com/v1

# TokenDance 云文生图 / 图生视频（未填 key 时不会假装成功，会按 fallback 策略处理）
IMAGE_API_STYLE=auto
IMAGE_BASE_URL=https://tokendance.space/gateway/ark/v3
IMAGE_API_KEY=
IMAGE_MODEL=seedream-5.0-pro
IMAGE_SIZE=2K
# 文生图读超时（秒）。实测同一网关在 37s~300s+ 之间波动，卡在多镜任务中间一镜
# 会把前面已出的图/视频全部作废。付费调用不自动重试（超时可能已出图并计费），
# 只调宽等待窗口。
IMAGE_TIMEOUT_SECONDS=600
IMAGE_SEED=0
IMAGE_STYLE_PREFIX=
IMAGE_NEGATIVE_PROMPT=
VIDEO_API_STYLE=auto
VIDEO_BASE_URL=https://tokendance.space/gateway/minimax/v2
VIDEO_API_KEY=
VIDEO_MODEL=minimax-h3
# 图生视频的分辨率是**按账号/模型计价**的，推断不出来：同一网关对 720P 返回
# "当前模型未配置该分辨率的价格"，对 768P 才放行。所以这里填账号已开通的档位，
# 不要跟着成片尺寸改。成片尺寸仍由 output_resolution 决定（渲染器负责缩放）。
VIDEO_RESOLUTION=768P
VIDEO_RATIO=9:16
VIDEO_POLL_INTERVAL=5
VIDEO_TIMEOUT=1800
MUSIC_DIR=runtime/music

# --- P3 逐镜配音运行时（可选；不装也能跑，默认走系统语音）---
# 只要 edge-tts 的话，建一个只装 edge-tts 的隔离环境就够（不拖 torch/whisperx）：
#   python -m venv .venv-audio
#   .\.venv-audio\Scripts\python.exe -m pip install edge-tts
# 还要做字级对齐（whisperx）才需要 scripts/setup-audio-runtime.ps1 那套完整依赖，
# 它要求 Python 3.11。
AUDIO_PYTHON=.venv-audio\Scripts\python.exe
AUDIO_DEVICE=cuda
AUDIO_COMPUTE_TYPE=float16
WHISPER_MODEL=small
AUDIO_MODEL_CACHE=runtime\models
AUDIO_ALLOW_CPU_FALLBACK=true
AUDIO_TIMEOUT_SECONDS=900

# 配音 provider：auto（默认，有云 TTS 走云，否则系统语音）/ windows / openai / edge
TTS_PROVIDER=auto
TTS_FALLBACK_PROVIDERS=edge-tts,windows-system-speech,offline-synthetic-tone

# --- 授权音乐目录（P3）---
# 只要用户选了"无音乐"以外的情绪，音频阶段就必须要有一首匹配的曲子，否则任务失败。
# 曲目必须同时满足：文件在 MUSIC_DIR 下、扩展名受支持、catalog.json 里 approved=true、
# 且该条的 moods / styles 与用户选择完全一致。选不到时的报错会点上这两项。
# catalog.json 结构：{"tracks":[{"file":"曲子.mp3","moods":["舒缓"],"styles":["诗意纪实"],
#                              "license":"...","author":"...","usage_scope":"...","approved":true}]}
MUSIC_CATALOG_PATH=runtime\music\catalog.json
CLOUD_MUSIC_ENABLED=false

# --- 素材来源降级链（P1/P2）---
ASSET_FALLBACK_PROVIDERS=local-library,offline

# --- 逐镜素材生成的并发数 ---
# 单镜实测约 110 秒（文生图 37~70s + 图生视频 44s），串行四镜要八分钟。
# 网关限流（429 / api_key_quota 之外的限速）时把这个值调小。
ASSET_CONCURRENCY=4
